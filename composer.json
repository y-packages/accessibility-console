{
    "name": "yaknet/accessibility-console",
    "description": "A professional AI-powered WCAG 2.1 accessibility scanner with self-healing capabilities.",
    "keywords": [
        "accessibility",
        "wcag",
        "a11y",
        "scanner",
        "ai",
        "gemini",
        "self-healing",
        "yaknet"
    ],
    "homepage": "https://forum.yak.net.tr",
    "version": "3.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "YakNet Bilişim",
            "email": "info@yakhub.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "google-gemini-php/client": "^1.0 || ^2.0",
        "guzzlehttp/guzzle": "^7.8",
        "masterminds/html5": "^2.8",
        "sabberworm/php-css-parser": "^8.4 || ^9.0",
        "chrome-php/chrome": "^1.15",
        "sebastian/diff": "^5.1 || ^6.0 || ^7.0 || ^8.0 || ^9.0",
        "php-di/php-di": "^7.1",
        "symfony/css-selector": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0",
        "spatie/color": "^1.5 || ^2.0",
        "intervention/image": "^2.7 || ^3.0"
    },
    "suggest": {
        "dompdf/dompdf": "Required for generating PDF Accessibility Certificates (^2.0 || ^3.0).",
        "phpoffice/phpspreadsheet": "Required for exporting Excel Accessibility Audit Reports (^1.28 || ^2.0 || ^3.0)."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "files": [
            "src/accessibility-console.php"
        ],
        "psr-4": {
            "YakNet\\AccessibilityConsole\\": "src/"
        }
    },
    "bin": [
        "bin/a11y"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
